// Prints usage and flag descriptions for the useradd utility.
// @return {none}
useraddHelp = function
    text = g.const.ni + g.l3("Usage:","u") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [user] [password]") + g.l2(" Create a user account on the current context's computer.  Names and passwords must be alphanumeric.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [-h/help]") + g.l2(" Displays this help text") + g.const.nl

    print(text)
end function

// Creates a user on the current context's computer.  Works on a shell, computer,
// or partial computer (pcomputer) context; on a pcomputer it requires create_user
// to be one of the object's available functions.
// @param {list<string>|null} args - Two elements: the username and password.
// @return {number} - 1 on success, 0 on failure.
doUseradd = function(args = null)
    if args == null or args == [] or args[0] == "-h" or args[0] == "help" then
        self.help
        return 0
    end if

    if args.len != 2 then
        self.help
        return 0
    end if

    context = g.stack[g.context.index]
    if not g.func.partialComputerReady(context, "create_user") then return 0

    user = args[0]
    password = args[1]

    result = context.computer.create_user(user, password)
    if result == null then
        print g.error("Failed to create user.")
        return 0
    end if
    if typeof(result) == "string" and result.len > 0 then
        print g.error(g.func.stripError(result))
        return 0
    end if

    print g.const.indent + g.s3("Created user " + user)
    g.func.partialSync(context)
    return 1
end function

g.util.useradd = {
    "name": "useradd",
    "shortDescription": "Create a user account.",
    "exec": @doUseradd,
    "help": @useraddHelp,
    "data": {}
}
