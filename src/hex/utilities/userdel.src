// Prints usage and flag descriptions for the userdel utility.
// @return {none}
userdelHelp = function
    text = g.const.ni + g.l3("Usage:","u") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" {-r} [user]") + g.l2(" Delete the specified user.  Optionally delete their home directory as well.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" {-r} [-a/all]") + g.l2(" Delete all users (except root) on the target.  Optionally delete their home directories as well.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [-h/help]") + g.l2(" Displays this help text") + g.const.nl

    print(text)
end function



// Deletes a user (or all non-root users) from the current context's computer.
// With [-r] also removes the user's home directory.
// @param {list<string>|null} args - One or two elements: optional ["-r"] and a username or ["all"].
// @return {number} - 1 on success, 0 otherwise.
doUserdel = function(args = null)
    // Partial-object context: delete a user via the single partial computer object.
    if g.func.isPartial(g.stack[g.context.index]) then
        context = g.stack[g.context.index]

        if args == null or args.len == 0 then
            print g.error("Usage on a partial object: userdel {-r} [user]")
            return 0
        end if
        if args[0] == "-h" or args[0] == "help" then
            self.help
            return 1
        end if

        deleteHome = 0
        userArg = null
        for a in args
            if a == "-r" then
                deleteHome = 1
            else
                userArg = a
            end if
        end for

        if userArg == null or userArg == "-a" or userArg == "all" then
            print g.error("Deleting all users is not supported on a partial object; specify a username.")
            return 0
        end if

        if context.computer == null then
            print g.error("This partial object has no computer component.")
            return 0
        end if
        if not g.func.partialHas(context, "computer", "delete_user") then
            print g.error("delete_user (userdel) is not available on this partial computer object.  Use 'partial' to see available functions.")
            return 0
        end if

        result = context.computer.delete_user(userArg, deleteHome)
        err = g.func.partialOpError(result)
        if err != "" then
            print g.error(err)
            return 0
        end if

        print g.const.indent + g.s3("Deleted user '" + userArg + "' via the partial computer object.")
        g.func.partialSync(context)
        return 1
    end if

    if args != null and args isa list and args.len  == 1 then
        if args[0] == "-h" or args[0] == "help" then
            self.help
            return 1
        end if

        idx = g.context.index

        if g.stack[idx].computer == null then
            print g.error("Context must be a shell or computer")
            return 0
        end if

        delete_home = args[0] == "-r"

        if args[-1] == "-a" or args[-1] == "all" then
            home = g.stack[idx].computer.File("/home")

            if not home then return 0

            users = home.get_folders

            for user in users
                if user.name == "guest" then continue
                result = g.stack[idx].computer.delete_user(user.name, delete_home)
                if result isa string then print g.error(result)
            end for

            return 1
        end if

        user = args[-1]

        result = g.stack[idx].computer.delete_user(user, delete_home)
        if result isa string then print g.error(result)

        return 1
    end if

    self.help
    return 0
end function

g.util.userdel = {
    "name": "userdel",
    "shortDescription": "Delete users",
    "exec": @doUserdel,
    "help": @userdelHelp,
}