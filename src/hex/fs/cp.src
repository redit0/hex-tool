// Prints usage and flag descriptions for the cp fs command.
// @return {none}
copyHelp = function
    text = g.const.ni + g.l3("Usage:","u") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [source] [destination]") + g.l2(" Copy a file or directory.  If the destination is an existing directory, the source is copied into it with the same name; otherwise the last segment of the destination is used as the new name.  Paths are treated as relative unless they begin with '/'.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [-h/help]") + g.l2(" Displays this help text") + g.const.nl

    print(text)
end function



// Copies a file or directory on the current context's file system.  If the destination
// resolves to an existing directory the source keeps its name; otherwise the destination
// is split into a parent directory (which must exist) and a new name.  Paths are
// relative to the current directory unless they begin with '/'.
// @param {list<string>|null} args - Two elements: the source and destination names or paths.
// @return {number} - 1 on success, 0 on failure.
doCopy = function(args = null)
    if args == null or args == [] or args[0] == "-h" or args[0] == "help" then
        self.help
        return 0
    end if

    if args.len != 2 then
        self.help
        return 0
    end if

    context = g.stack[g.context.index]

    paths = []
    for arg in args
        path = arg
        if path[0] != "/" then path = context.currentPath + "/" + path
        path = path.replace("//", "/")
        if path.len > 1 and path[-1] == "/" then path = path[:-1]
        paths.push(path)
    end for

    source = g.func.resolveFile(context.file, paths[0])

    if source == null then
        print g.error("No such file or directory: " + paths[0])
        return 0
    end if

    dest = g.func.resolveFile(context.file, paths[1])

    if dest != null and dest.is_folder then
        destFolder = dest
        newName = source.name
    else
        parts = paths[1].split("/")
        newName = parts.pop
        parentPath = parts.join("/")
        if parentPath == "" then parentPath = "/"

        destFolder = g.func.resolveFile(context.file, parentPath)

        if destFolder == null or not destFolder.is_folder then
            print g.error("Destination directory not found: " + parentPath)
            return 0
        end if
    end if

    if newName == "" or newName == "/" then
        print g.error("Cannot copy " + source.path + " without a destination name.  Specify one, e.g. [cp " + paths[0] + " " + (paths[1] + "/backup").replace("//", "/") + "].")
        return 0
    end if

    if source.is_folder and (destFolder.path == source.path or destFolder.path.indexOf(source.path + "/") == 0) then
        print g.error("Cannot copy a directory into itself.")
        return 0
    end if

    for f in destFolder.get_folders + destFolder.get_files
        if f.name == newName and f.path != source.path then
            print g.const.indent + g.l2("Overwriting " + f.path + "...")
            break
        end if
    end for

    result = source.copy(destFolder.path, newName)

    if typeof(result) == "string" and result.len > 0 then
        print g.error(g.func.stripError(result))
        return 0
    end if

    print g.const.indent + g.s3("Copied " + source.path + " to " + (destFolder.path + "/" + newName).replace("//", "/"))
    return 1
end function

g.fs.cp = {
    "name": "cp",
    "shortDescription": "Copy a file or directory.",
    "exec": @doCopy,
    "help": @copyHelp,
}
